#!/usr/bin/env bash
# Build Silent Scribe Docker image

set -euo pipefail
cd "$(dirname "$0")"

echo "🚀 Building Silent Scribe..."
echo "⚠️  This will take 30-60 minutes if downloading models"
echo ""

sudo docker build -t silent-scribe:latest -f docker/Dockerfile .

echo ""
echo "✅ Build complete!"
echo ""
echo "Run with: ./start"
